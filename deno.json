{
  "nodeModulesDir": "auto",
  "imports": {
    "@shared/": "./shared/types/",
    "@alanya-holidays/shared": "./shared/types/index.ts",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.22.0"
  },
  "exclude": [
    "backend/",
    "frontend/",
    "shared/",
    "dist/",
    "node_modules/",
    ".next/",
    "dock/",
    "db_scripts/"
  ],
  "tasks": {
    "lint": "deno lint",
    "check": "deno check"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": [
        "no-console",
        "no-explicit-any"
      ]
    },
    "exclude": ["backend/", "frontend/", "shared/", "dist/", "node_modules/", ".next/"]
  },
  "fmt": {
    "exclude": ["backend/", "frontend/", "shared/", "dist/", "node_modules/", ".next/"],
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true
  }
}
