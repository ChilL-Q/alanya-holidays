{
  "nodeModulesDir": "auto",
  "tasks": {
    "lint": "deno lint",
    "check": "deno check"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": [
        "no-console",
        "no-explicit-any"
      ]
    },
    "exclude": ["dist/", "node_modules/", ".next/"]
  },
  "fmt": {
    "exclude": ["dist/", "node_modules/", ".next/"],
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true
  }
}
