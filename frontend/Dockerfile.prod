# Stage 1: Build static assets
FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_GOOGLE_MAPS_API_KEY
ARG VITE_APP_URL
ARG VITE_SENTRY_DSN

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY
ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY shared/package.json ./shared/
COPY frontend/package.json ./frontend/

RUN pnpm install --frozen-lockfile

COPY shared ./shared
COPY frontend ./frontend

RUN pnpm --filter @alanya-holidays/shared build
RUN pnpm --filter @alanya-holidays/frontend build

# Stage 2: Serve static assets with Nginx
FROM nginx:alpine AS runner
COPY --from=builder /app/frontend/dist /dist-build
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:80/ || exit 1

CMD ["sh", "-c", "cp -rf /dist-build/* /usr/share/nginx/html/ && exec nginx -g 'daemon off;'"]
