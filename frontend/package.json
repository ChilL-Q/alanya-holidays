    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.0",
    "lucide-react": "^0.562.0",
    "marked": "^18.0.5",
    "react": "^19.2.3",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-imask": "^7.6.1",
    "react-router-dom": "^7.11.0",
