{
  "name": "alanya-holidays",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-vercel-json.js && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "dotenv -e .env.test vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:lint": "deno lint --config=deno.json supabase/functions",
    "supabase:type-check": "deno check --config=deno.json supabase/functions/**/*.ts",
    "sync-reviews": "tsx scripts/sync-google-reviews.ts"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "@headlessui/react": "^2.2.9",
