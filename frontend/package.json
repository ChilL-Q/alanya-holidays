    "@sentry/react": "^10.48.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/react-datepicker": "^6.2.0",
