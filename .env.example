# ============================================================
# Frontend environment variables (VITE_* — public, baked into the SPA bundle)
# ============================================================
# Base URL for the NestJS API. Leave empty in production (nginx proxies /api).
VITE_API_URL=http://localhost:4000/api
# Supabase project credentials (aliases VITE_PUBLIC_SUPABASE_URL / VITE_PUBLIC_SUPABASE_ANON_KEY are also accepted)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_anon_key
# Only consumed by scripts/sync-google-reviews.ts, not by the SPA bundle
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key
# Sentry browser SDK
VITE_SENTRY_DSN=your_sentry_dsn_here
# Shown in Sentry releases; falls back to 0.0.1 when empty
VITE_APP_VERSION=1.0.0

# ============================================================
# Server-side only keys (NOT exposed in frontend bundle)
# ============================================================
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI providers (Nest /ai/* + Edge Functions)
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the Gemini model (default: gemini-2.0-flash-001)
# GEMINI_MODEL=gemini-2.0-flash-001
CLAUDE_API_KEY=your_claude_api_key

# Email service (Resend — Edge Function send-email)
RESEND_API_KEY=your_resend_api_key

# ============================================================
# Stripe payment configuration
# ============================================================
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# Optional: pin the Stripe API version used by the backend adapter
# STRIPE_API_VERSION=2026-08-01
# Voyager subscription (optional — inline €19/mo · €190/yr fallback is used when empty)
STRIPE_VOYAGER_PRICE_ID=price_voyager_monthly
STRIPE_VOYAGER_ANNUAL_PRICE_ID=price_voyager_annual
# Listing addon checkout prices (optional — addon hidden when its price is unset)
STRIPE_ADDON_VERIFIED_BADGE_PRICE_ID=
STRIPE_ADDON_SEASONAL_PLACEMENT_PRICE_ID=
STRIPE_ADDON_SPONSORED_ARTICLE_PRICE_ID=
STRIPE_ADDON_AI_LOCALIZATION_PRICE_ID=

# ============================================================
# Application settings (backend)
# ============================================================
SITE_URL=https://alanyaholidays.com
# Canonical app URL used for emails/links; defaults to https://alanyaholidays.com
APP_URL=https://alanyaholidays.com
# Comma-separated CORS allowlist; SITE_URL is always allowed as fallback
CORS_ALLOWED_ORIGINS=https://alanyaholidays.com,https://www.alanyaholidays.com
# Backend listen port (default 4000) and proxy trust flag for nginx setups
PORT=4000
TRUST_PROXY=1
# Admin notification target for new directory listings
ADMIN_NOTIFICATION_EMAIL=admin@alanyaholidays.com
# Admin email for lawyer contact form submissions
LAWYER_ADMIN_EMAIL=admin@alnya-holidays.com

# ============================================================
# Redis Caching
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# Sentry (server-side exception reporting)
# ============================================================
SENTRY_DSN=your_sentry_dsn_here

# ============================================================
# PostgreSQL Automated Backups & Cloudflare R2 / S3 Remote Dispatch
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
# Optional: Alternative single connection URI
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/postgres
BACKUP_DIR=/tmp/pg_backups

# S3-compatible remote storage (Cloudflare R2 / AWS S3)
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=alanya-holidays-backups
S3_REGION=auto
S3_ACCESS_KEY_ID=your_r2_or_s3_access_key
S3_SECRET_ACCESS_KEY=your_r2_or_s3_secret_key
S3_PREFIX=postgres/

# Retention Policy Configuration (GFS 7-daily + 4-weekly)
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
